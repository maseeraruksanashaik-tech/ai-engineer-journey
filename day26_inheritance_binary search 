# Example 1: Inheritance using Human and LivingBeing

class Human:
    def __init__(self, gender, age):
        self.gender = gender
        self.age = age

    def display(self):
        print("Gender:", self.gender)
        print("Age:", self.age)


class LivingBeing(Human):
    def __init__(self, gender, age, country):
        super().__init__(gender, age)
        self.country = country

    def display_country(self):
        print("Country:", self.country)


human1 = Human("Male", 23)
human1.display()

person1 = LivingBeing("Female", 18, "India")
person1.display()
person1.display_country()


# Example 2: Inheritance using Parent and Child

class Parent:
    def __init__(self, name):
        self.name = name

    def display(self):
        print("Name:", self.name)


class Child(Parent):
    def __init__(self, name, age):
        super().__init__(name)
        self.age = age

    def display(self):
        print("Name:", self.name)
        print("Age:", self.age)


parent1 = Parent("sanu")
parent1.display()

child1 = Child("sanu", 18)
child1.display()
